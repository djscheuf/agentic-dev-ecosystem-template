{
  "PreToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/verify-secrets.sh --scope=staged"
        }
      ]
    },
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/pre-tool-verify-windsurf.sh"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "edit|write",
      "hooks": [
        {
          "type": "command",
          "command": "bash .devin/scripts/post-edit-verify-windsurf.sh"
        },
        {
          "type": "command",
          "command": "bash .devin/scripts/post-edit-verify-skill.sh"
        }
      ]
    }
  ]
}
